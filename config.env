# =============================================================================
# バックアップ共通設定
#   各スクリプトはこのファイルを読み込んで動作します。
#   サーバーリプレース時はこの値だけ見直せばOK。
# =============================================================================

# 同期元（rsync の対象）。スペース区切りで複数指定可。
SOURCE_DIRS="/home /etc"

# バックアップ先のルート
BACKUP_ROOT="/mnt/disk/backup"

# rsync の同期先（このサブディレクトリ配下に home/ etc/ が作られる）
SYNC_DEST="${BACKUP_ROOT}/pidev"

# 週次アーカイブ(tar)の出力先
ARCHIVE_DIR="${BACKUP_ROOT}/archives"

# 保持する世代数（週次なので 4 = 約1ヶ月）
ARCHIVE_KEEP=4

# ログ出力先
LOG_DIR="/var/log/home-backup"
